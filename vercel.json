{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main-rrucig": false,
      "resultats": false,
      "cotes-tennis": false,
      "donnees-tennis": false,
      "donnees-stats": false,
      "donnees-matchs": false,
      "controles": false
    }
  }
}
