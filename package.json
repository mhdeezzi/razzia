{
  "name": "simlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moteur de simulation Monte Carlo possession par possession (NBA d'abord, multi-sports ensuite) + rendu 2D du match typique",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ingest": "node src/cli/ingest.ts",
