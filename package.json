    "slate": "node src/cli/slate.ts",
    "backtest": "node src/cli/backtest.ts",
    "viewer": "vite --config viewer/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "props-backtest": "node src/cli/propsbacktest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
